# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/resqpaws

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=resqpaws_token

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=resqpaws

# ---- Seed (demo only, never production) ----
SEED_PASSWORD=demo1234
